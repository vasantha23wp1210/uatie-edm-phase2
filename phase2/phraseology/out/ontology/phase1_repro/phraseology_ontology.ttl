<http://aviation.safety.ontology/phraseology> a owl:Ontology ;
    rdfs:label "CAA ATC Phraseology Ontology"@en ;
    rdfs:comment "Ontology for CAA ATC Section 8 phraseology cross-mapped with ICAO Doc 4444"@en .

aviation:belongsToSection a owl:ObjectProperty ;
    rdfs:label "belongsToSection"@en ;
    rdfs:comment "Links a phraseology to its document section"@en .

aviation:belongsToService a owl:ObjectProperty ;
    rdfs:label "belongsToService"@en ;
    rdfs:comment "Links a phraseology to its ATC service category"@en .

aviation:hasCircumstance a owl:ObjectProperty ;
    rdfs:label "hasCircumstance"@en ;
    rdfs:comment "Links a phraseology to its triggering circumstance"@en .

aviation:hasPhrase a owl:DatatypeProperty ;
    rdfs:label "hasPhrase"@en ;
    rdfs:comment "The literal text of the phraseology"@en .

aviation:hasSpeaker a owl:ObjectProperty ;
    rdfs:label "hasSpeaker"@en ;
    rdfs:comment "Links a phraseology to the speaker role"@en .

aviation:matchScore a owl:DatatypeProperty ;
    rdfs:label "matchScore"@en ;
    rdfs:comment "Cosine similarity score between CAA and ICAO phrase"@en .

aviation:matchType a owl:DatatypeProperty ;
    rdfs:label "matchType"@en ;
    rdfs:comment "Classification of match quality"@en .

aviation:matchesICAO a owl:ObjectProperty ;
    rdfs:label "matchesICAO"@en ;
    rdfs:comment "Links a CAA phraseology to its best ICAO equivalent"@en .

aviation:sectionNumber a owl:DatatypeProperty ;
    rdfs:label "sectionNumber"@en ;
    rdfs:comment "Section number in the source document"@en .

aviation:sectionTitle a owl:DatatypeProperty ;
    rdfs:label "sectionTitle"@en ;
    rdfs:comment "Section title in the source document"@en .

aviation:triggersPhrase a owl:ObjectProperty ;
    rdfs:label "triggersPhrase"@en ;
    rdfs:comment "Links a circumstance to the phraseology it triggers"@en .

aviation:variableCount a owl:DatatypeProperty ;
    rdfs:label "variableCount"@en ;
    rdfs:comment "Number of variable slots in the phraseology"@en .

