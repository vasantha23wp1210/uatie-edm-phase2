atc:SPEAKER_PILOT a aviation:Speaker ;
    rdfs:label "Pilot"@en .

atc:SVC_GENERAL_PHRASEOLOGY a aviation:ATCService ;
    rdfs:label "General Phraseology"@en .

aviation:ATCSection a owl:Class ;
    rdfs:label "ATCSection"@en ;
    rdfs:comment "A numbered section within the ATC standards document"@en .

atc:SVC_AERODROME_CONTROL_SERVICE a aviation:ATCService ;
    rdfs:label "Aerodrome Control Service"@en .

aviation:ICAOPhraseology a owl:Class ;
    rdfs:label "ICAOPhraseology"@en ;
    rdfs:comment "A phraseology defined in ICAO Doc 4444"@en ;
    rdfs:subClassOf aviation:Phraseology .

atc:SPEAKER_ATC a aviation:Speaker ;
    rdfs:label "ATC"@en .

aviation:CAAPhraseology a owl:Class ;
    rdfs:label "CAAPhraseology"@en ;
    rdfs:comment "A phraseology defined in CAA ATC Section 8"@en ;
    rdfs:subClassOf aviation:Phraseology .

aviation:Circumstance a owl:Class ;
    rdfs:label "Circumstance"@en ;
    rdfs:comment "An operational condition that triggers a phraseology"@en .

