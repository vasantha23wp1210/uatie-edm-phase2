atc:SEC_122_TERRAIN_ALERT a aviation:ATCSection ;
    rdfs:label "12.2 Terrain Alert"@en .

atc:SEC_26_CLEARANCE_CANNOT_BE_ISSUED_IMMEDIATELY a aviation:ATCSection ;
    rdfs:label "2.6 Clearance Cannot Be Issued Immediately"@en .

atc:SEC_41_IDENTIFICATION_OF_AIRCRAFT a aviation:ATCSection ;
