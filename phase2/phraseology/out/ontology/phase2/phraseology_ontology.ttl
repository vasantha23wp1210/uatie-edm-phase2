atc:SEC_55_INBOUND_RELEASE a aviation:ATCSection ;
    rdfs:label "5.5 Inbound Release"@en .

atc:SEC_56_HANDOVER a aviation:ATCSection ;
    rdfs:label "5.6 Handover"@en .

atc:SEC_62_POSITION_INFORMATION a aviation:ATCSection ;
    rdfs:label "6.2 Position Information"@en .

atc:SEC_83_SRA_POSITION a aviation:ATCSection ;
    rdfs:label "8.3 SRA Position"@en .

