atc:SEC_108_EMERGENCY_CODE a aviation:ATCSection ;
    rdfs:label "10.8 Emergency Code"@en .

atc:SEC_109_TERMINATION_OF_TRANSPONDER a aviation:ATCSection ;
    rdfs:label "10.9 Termination of Transponder"@en .

atc:SEC_111_ADS_DEGRADATION a aviation:ATCSection ;
